# ── Database Configuration ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ── API Server Configuration ───────────────────────────────────
HOST=127.0.0.1
PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# ── Google Gemini AI Configuration ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ── Scraper Automation (Runs on boot, then every 3 hours) ─────
SCRAPE_INTERVAL_SECONDS=10800
SCRAPE_INITIAL_DELAY_SECONDS=5

# ── Auth (REQUIRED for real use) ───────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random secret is made on each start and everyone is logged out on restart.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=480
# Refresh-token lifetime for mobile clients (days)
MOBILE_REFRESH_DAYS=30
# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Alerts & daily briefing by email (leave SMTP_HOST empty to keep email OFF) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
APP_BASE_URL=http://127.0.0.1:8000
ALERT_CHECK_MINUTES=10
BRIEFING_HOUR=7
TIMEZONE=Asia/Kolkata

# News tone without a Gemini key: 'false' = anything without a negative word is 'positive' (original). 'true' = it is
# 'neutral' unless it has a clearly positive word. See docs/PRODUCT_MAP.md (News accuracy).
SENTIMENT_NEUTRAL_FALLBACK=false

# ── Local AI for news tone (free, private; needs Ollama running and a model pulled). Empty = off (keyword rules only) ──
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_MAX_PER_CYCLE=400
OLLAMA_MAX_SECONDS_PER_CYCLE=600
