# Copy to .env.production and fill in. NEVER commit the real file (it is git-ignored). Values below are placeholders.
# ── Database (the db container is created with these) ──
DB_USER=aso
DB_NAME=ai_smart_office
DB_PASSWORD=CHANGE_ME_use_a_long_random_password
# ── App ──
APP_ENV=production
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
TIMEZONE=Asia/Kolkata
# ── Address (the domain must point at this server for the automatic HTTPS certificate) ──
SITE_ADDRESS=smartoffice.example.org
APP_BASE_URL=https://smartoffice.example.org
# ── Email alerts and morning briefing (optional; OFF until both HOST and FROM are set) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BRIEFING_HOUR=7
# ── Optional AI (leave empty to run without) ──
GEMINI_API_KEY=
